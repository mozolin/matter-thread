menu "2. Lib Drivers: SSD1306 LED Display"
  #//-- SSD1306 LED Display
  config SSD1306_ENABLED
    bool "CONFIG_SSD1306_ENABLED"
    default n
  #/**********************************************************
  # *
  # *  This driver initializes the I2C bus
  # *  on port CONFIG_SSD1306_I2C_PORT;
  # *  therefore, any sensors using the I2C interface
  # *  must be connected to the same GPIO pins (SDA and SCL)
  # *  if they use this port.
  # *
  # **********************************************************/
  config SSD1306_SDA_GPIO
    int "CONFIG_SSD1306_SDA_GPIO"
    default 1
  config SSD1306_SCL_GPIO
    int "CONFIG_SSD1306_SCL_GPIO"
    default 2
  config SSD1306_RESET_GPIO
    int "CONFIG_SSD1306_RESET_GPIO"
    default -1
  config SSD1306_I2C_ADDRESS
    hex "CONFIG_SSD1306_I2C_ADDRESS"
    default 0x3C
  config SSD1306_I2C_PORT
    int "CONFIG_SSD1306_I2C_PORT"
    default 0
  config SSD1306_APP_RUN_CB
    bool "CONFIG_SSD1306_APP_RUN_CB"
    default y
  config SSD1306_AUTO_OFF_TIMEOUT_MS
    int "CONFIG_SSD1306_AUTO_OFF_TIMEOUT_MS"
    default 300000  #// 5 минут
endmenu


