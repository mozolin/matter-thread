  config LIVE_BLINK_TIME_MS
    int "CONFIG_LIVE_BLINK_TIME_MS"
    default 0
endmenu


menu "8. Lib Drivers: Reboot Button"
  #//-- Single-click: toggle SSD1306
  #//-- Double-click: toggle LED Indicator
  config REBOOT_BUTTON_GPIO
    int "CONFIG_REBOOT_BUTTON_GPIO"
    default 9
  #//-- Hold to reboot
  config REBOOT_HOLD_TIME_MS
    int "CONFIG_REBOOT_HOLD_TIME_MS"
    default 3000
  #//-- Hold to factory reset
  config FACTORY_RESET_HOLD_TIME_MS
    int "CONFIG_FACTORY_RESET_HOLD_TIME_MS"
    default 10000
  #//=== параметры детекции двойного нажатия кнопки Reboot ===
  #//-- интервал между первым и вторым нажатием для распознавания двойного клика (мс)
  config DOUBLE_CLICK_INTERVAL_MS
    int "CONFIG_DOUBLE_CLICK_INTERVAL_MS"
    default 400
  #//-- максимальная длительность короткого нажатия (мс) — иначе это не "клик"
  config SHORT_CLICK_MAX_MS
    int "CONFIG_SHORT_CLICK_MAX_MS"
    default 350
endmenu


