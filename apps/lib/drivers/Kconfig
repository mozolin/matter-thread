menu "5. Lib Drivers: Boot Switch"
  #//-- Boot Switch (Generic Switch) для событий кнопки BOOT
  config BOOT_SWITCH_ENABLED
    bool "CONFIG_BOOT_SWITCH_ENABLED"
    default y
  #//-- Reboot button handlers
  config REBOOT_BUTTON_ENABLED
    bool "CONFIG_REBOOT_BUTTON_ENABLED"
    default y
endmenu


menu "6. Lib Drivers: Task Priorities"
  #/***********************
  # *                     *
  # *   TASK PRIORITIES   *
  # *                     *
  # ***********************/
  #//-- task priorities
  #// ============================================================
  #// Задача опроса Boot Switch
  #// Приоритет 3 (ниже reboot_button=4 и sensor_poll=5),
  #// потому что:
  #//   • кнопка — событие для человека, задержка 20–50 мс не заметна
  #//   • reboot_button (4) уже опрашивает тот же GPIO — boot_switch
  #//     не должен его вытеснять
  #//   • sensor_poll (5) имеет более строгие тайминги (BME680/DS18B20)
  #//   • Matter-события уходят в HA без задержек
  #// ============================================================
  config COMMISSIONING_WINDOW_PRIORITY
    int "CONFIG_COMMISSIONING_WINDOW_PRIORITY"
    default 6
  config SENSOR_POLL_TASK_PRIORITY
    int "CONFIG_SENSOR_POLL_TASK_PRIORITY"
    default 5
  config REBOOT_BUTTON_TASK_PRIORITY
    int "CONFIG_REBOOT_BUTTON_TASK_PRIORITY"
    default 4
  config BOOT_SWITCH_TASK_PRIORITY
    int "CONFIG_BOOT_SWITCH_TASK_PRIORITY"
    default 3
endmenu


