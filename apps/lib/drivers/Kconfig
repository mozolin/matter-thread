    default 0
    range 0 1
  #//-- I2C Bus=1
  config I2C_1_SDA_GPIO
    int "CONFIG_I2C_1_SDA_GPIO"
    default 3
  config I2C_1_SCL_GPIO
    int "CONFIG_I2C_1_SCL_GPIO"
    default 5
  config I2C_1_PORT_NUM
    int "CONFIG_I2C_1_PORT_NUM"
    default 1
    range 0 1
endmenu


